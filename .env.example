# Names only, no values. Copy to `.env` for a developer's shell:
#
#   cp .env.example .env      # then fill in, then: set -a; . ./.env; set +a
#
# `.env` is git-ignored. NEVER commit a filled-in one: `INV-08` forbids a token in any log line,
# and the surest way to leak one is to check it in.
#
# **Nothing reads these yet.** #3 (REST) and #4 (socket) consume them, #8 finalises the names and
# adds the file-based credential the wall actually runs with — a wall process started by the
# compositor has no shell environment, so the deployed credential is
# `$XDG_CONFIG_HOME/arcons-cc/credentials.toml` (mode 600), not this file.

# The Minos base URL. This is the only address you have to give:
#   https://minos.example       REST on 443, socket derived as wss://minos.example/connection/websocket
#   http://minos.example:8080   REST on 8080, socket derived as ws://minos.example:8000/connection/websocket
MINOS_BASE_URL=

# Optional. Set only when the socket is not where MINOS_BASE_URL implies.
MINOS_SOCKET_URL=

# The credential, one of these two. The refresh token is preferred for a deployment: a wall can
# hold one for a long time, and a password at rest is a password to rotate.
MINOS_REFRESH_TOKEN=
MINOS_IDENTIFIER=
MINOS_PASSWORD=

# The wall account needs the `read` action on `/system/live-feed`, and nothing else.
# It does not need a commander account: this display never posts a fix, an order or a message.

# Optional: boot into an exercise's plot instead of the live feed. v0.2 (#11) — leave empty for now.
MINOS_GAME_ID=

# Optional: the Vulkan driver the MAP renders through, as an ICD path. On this hybrid laptop the panel
# is wired to the Intel iGPU and MapLibre otherwise picks the RTX 2050 (ADR-0001 records the finding
# and the value that works here). Unset means "whatever the loader picks".
#   ARCONS_MAP_VK_DRIVER=/usr/share/vulkan/icd.d/intel_icd.json
ARCONS_MAP_VK_DRIVER=
