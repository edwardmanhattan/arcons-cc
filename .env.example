# Names only, no values. Copy to `.env` for a developer's shell:
#
#   cp .env.example .env      # then fill in, then: set -a; . ./.env; set +a
#
# `.env` is git-ignored. NEVER commit a filled-in one: `INV-08` forbids a token in any log line,
# and the surest way to leak one is to check it in.
#
# These are the DEVELOPER's route (`#8`). A wall process started by the compositor has no shell
# environment: it reads `$XDG_CONFIG_HOME/arcons-cc/config.toml` and the credential file that names,
# mode 600. Environment wins over that file and loses to a flag — see `docs/runbook.md`.
#
#   ~/.config/arcons-cc/config.toml        minos_url, centrifugo_url, credentials, map_center, …
#   ~/.config/arcons-cc/credentials.toml   refresh_token, or identifier + password (mode 600)

# The Minos base URL. This is the only address you have to give:
#   https://minos.example       REST on 443, socket derived as wss://minos.example/connection/websocket
#   http://minos.example:8080   REST on 8080, socket derived as ws://minos.example:8000/connection/websocket
MINOS_BASE_URL=

# Optional. Set only when the socket is not where MINOS_BASE_URL implies.
MINOS_SOCKET_URL=

# The credential, one of these two. The refresh token is preferred for a deployment: a wall can
# hold one for a long time, and a password at rest is a password to rotate.
MINOS_REFRESH_TOKEN=
MINOS_IDENTIFIER=
MINOS_PASSWORD=

# The wall account needs the `read` action on `/system/live-feed`, AND on `/system/units` (identity,
# commander, specification: the unit card).
# It does not need a commander account: this display never posts a fix, an order or a message.

# Optional: boot into an exercise's plot instead of the live feed. v0.2 (#11) — leave empty for now.
MINOS_GAME_ID=

# Optional: which Vulkan driver the MAP renders through (#16). `auto` (the default) picks the
# integrated GPU, which on a hybrid laptop is where the panel hangs off — and what Rune itself uses.
#   auto                                the integrated GPU (default)
#   off                                 whatever the Vulkan loader picks
#   /usr/share/vulkan/icd.d/intel_icd.json   that ICD, verbatim
# ADR-0001 records why: MapLibre sorts devices itself and takes the discrete card on this laptop.
ARCONS_MAP_VK_DRIVER=auto
